# Usher Library — example environment values for local development.
# Copy this file to `.env` and adjust if needed. NEVER commit a real `.env`.
# All values below are placeholders / development defaults; rotate any real
# credentials and keep them out of version control.

# ---- PostgreSQL ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=usher_library
POSTGRES_USER=usher
POSTGRES_PASSWORD=change_me_in_local_env

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---- Backend (FastAPI) ----
DATABASE_URL=postgresql+asyncpg://usher:change_me_in_local_env@postgres:5432/usher_library
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Short timeout (seconds) used by `GET /health` for each connectivity
# probe. Keep this low so the endpoint responds quickly when a
# dependency hangs (RF-9).
PROBE_TIMEOUT_SECONDS=1.0
# Total time (seconds) the backend entrypoint waits for PostgreSQL
# and Redis to become reachable before giving up. Should cover the
# typical cold start of the database and the cache (RF-7).
STARTUP_TIMEOUT_SECONDS=30.0

# ---- Frontend ----
FRONTEND_PORT=5173

# ---- Keycloak ----
KEYCLOAK_HOST=keycloak
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_in_local_env
KEYCLOAK_REALM=usher-library