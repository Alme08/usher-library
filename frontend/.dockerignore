# Build context for the frontend image. Mirrors `.gitignore` for the
# Node side and adds a few Dockerfile-specific exclusions.

# Secrets and local config
.env
.env.*
!.env.example

# Node artefacts
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.vite/
.cache/
.parcel-cache/
.turbo/
coverage/
*.tsbuildinfo
dist/

# Editor / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Docker artefacts (avoid recursive self-include)
Dockerfile
.dockerignore
